@KnowledgeTracker.Web_HostAddress = http://localhost:5015

GET {{KnowledgeTracker.Web_HostAddress}}/weatherforecast/
Accept: application/json

###

@accessToken = replace-with-an-access-token
@topicId = replace-with-an-unused-topic-id

DELETE {{KnowledgeTracker.Web_HostAddress}}/api/topics/{{topicId}}
Authorization: Bearer {{accessToken}}

###

@subjectGoalId = replace-with-a-subject-goal-id

PUT {{KnowledgeTracker.Web_HostAddress}}/api/subject-goals/{{subjectGoalId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "topicId": "{{topicId}}",
  "title": "Read 100 pages",
  "kind": 1,
  "metricDefinitionId": "replace-with-a-metric-definition-id",
  "targetValue": 100,
  "targetDate": null,
  "period": 0,
  "periodStartDate": null,
  "periodEndDate": null,
  "subGoals": []
}

###

PUT {{KnowledgeTracker.Web_HostAddress}}/api/subject-goals/{{subjectGoalId}}/day-records/2026-08-17
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "isCompleted": true
}
