@KnowledgeTracker.Web_HostAddress = http://localhost:5015

GET {{KnowledgeTracker.Web_HostAddress}}/weatherforecast/
Accept: application/json

###

@accessToken = replace-with-an-access-token
@topicId = replace-with-an-unused-topic-id
@workspaceId = replace-with-a-workspace-id

### List workspaces
GET {{KnowledgeTracker.Web_HostAddress}}/api/workspaces
Authorization: Bearer {{accessToken}}

### Create a workspace
POST {{KnowledgeTracker.Web_HostAddress}}/api/workspaces
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Programming"
}

### Select a workspace for knowledge endpoints
GET {{KnowledgeTracker.Web_HostAddress}}/api/subjects
Authorization: Bearer {{accessToken}}
X-Workspace-Id: {{workspaceId}}

DELETE {{KnowledgeTracker.Web_HostAddress}}/api/topics/{{topicId}}
Authorization: Bearer {{accessToken}}

###

@subjectGoalId = replace-with-a-subject-goal-id

PUT {{KnowledgeTracker.Web_HostAddress}}/api/subject-goals/{{subjectGoalId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "topicId": "{{topicId}}",
  "title": "Read 100 pages",
  "kind": 1,
  "metricDefinitionId": "replace-with-a-metric-definition-id",
  "targetValue": 100,
  "targetDate": null,
  "period": 0,
  "periodStartDate": null,
  "periodEndDate": null,
  "subGoals": []
}

### Goal activity for a UTC dashboard range
GET {{KnowledgeTracker.Web_HostAddress}}/api/goal-activity?from=2026-08-01&to=2026-08-31
Authorization: Bearer {{accessToken}}
